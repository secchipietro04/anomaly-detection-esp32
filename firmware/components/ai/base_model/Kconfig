menu "AI Engine Configuration"

    config AI_ENABLE_DA
        bool "Enable Dense Autoencoder (DA)"
        default y
        select TFL_USE_FULLY_CONNECTED
        select TFL_USE_RELU
        select TFL_USE_SUB
        select TFL_USE_SQUARE
        select TFL_USE_MEAN
        help
            Enables operator registration for Dense Autoencoder (DA) model.

    config AI_ENABLE_VA
        bool "Enable Variational Autoencoder (VA)"
        default y
        select TFL_USE_FULLY_CONNECTED
        select TFL_USE_RELU
        select TFL_USE_EXP
        select TFL_USE_MUL
        select TFL_USE_ADD
        select TFL_USE_SUB
        select TFL_USE_SQUARE
        select TFL_USE_MEAN
        help
            Enables operator registration for Variational Autoencoder (VA) model.

