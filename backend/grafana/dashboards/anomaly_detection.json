{
  "title": "Edge-AI Vibration & Model Dashboard",
  "uid": "edge-ai-anomaly",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Anomaly Score (MSE) over Time",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 16, "h": 8 },
      "datasource": "TimescaleDB",
      "targets": [
        {
          "rawSql": "SELECT timestamp AS time, node_id, mse FROM inference_results WHERE $__timeFilter(timestamp) ORDER BY timestamp",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.1, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Node Health (RAM Free & SD Status)",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "datasource": "TimescaleDB",
      "targets": [
        {
          "rawSql": "SELECT timestamp AS time, node_id, ram_free FROM node_health WHERE $__timeFilter(timestamp) ORDER BY timestamp",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 3,
      "title": "Active Deployed Ensembles",
      "type": "table",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 6 },
      "datasource": "TimescaleDB",
      "targets": [
        {
          "rawSql": "SELECT deployed_at, node_id, router_model_id, memory_model_id, total_size_bytes, routes FROM ensembles ORDER BY deployed_at DESC LIMIT 20",
          "format": "table"
        }
      ]
    },
    {
      "id": 4,
      "title": "Trained Models Library in Database",
      "type": "table",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 6 },
      "datasource": "TimescaleDB",
      "targets": [
        {
          "rawSql": "SELECT id AS model_id, node_id, model_type, tag, size_bytes, created_at FROM models ORDER BY created_at DESC LIMIT 50",
          "format": "table"
        }
      ]
    },
    {
      "id": 5,
      "title": "Node Hardware Capabilities & Enabled Ops",
      "type": "table",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 6 },
      "datasource": "TimescaleDB",
      "targets": [
        {
          "rawSql": "SELECT node_id, accel_freqs, gyro_freqs, enabled_ops, updated_at FROM node_capabilities ORDER BY updated_at DESC",
          "format": "table"
        }
      ]
    },
    {
      "id": 6,
      "title": "Raw Telemetry Volume per Sensor (Bytes)",
      "type": "bargauge",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 6 },
      "datasource": "TimescaleDB",
      "targets": [
        {
          "rawSql": "SELECT node_id, SUM(raw_bytes_count) AS total_bytes FROM raw_telemetry GROUP BY node_id ORDER BY total_bytes DESC",
          "format": "table"
        }
      ]
    },
    {
      "id": 7,
      "title": "Edge Inference Execution Time (ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": "TimescaleDB",
      "targets": [
        {
          "rawSql": "SELECT timestamp AS time, node_id, inference_time_ms FROM inference_results WHERE inference_time_ms IS NOT NULL AND $__timeFilter(timestamp) ORDER BY timestamp",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 50, "color": "yellow" },
              { "value": 100, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "title": "Average Inference Latency by Submodel (Efficiency)",
      "type": "bargauge",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": "TimescaleDB",
      "targets": [
        {
          "rawSql": "SELECT CONCAT('Model #', autoencoder_model_id) AS metric, AVG(inference_time_ms) AS avg_time_ms FROM inference_results WHERE inference_time_ms IS NOT NULL GROUP BY autoencoder_model_id ORDER BY avg_time_ms ASC",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 40, "color": "yellow" },
              { "value": 80, "color": "red" }
            ]
          }
        }
      }
    }
  ]
}
